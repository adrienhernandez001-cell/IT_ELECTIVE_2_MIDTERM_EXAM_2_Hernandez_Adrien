@model IEnumerable<ClinicPatientVisitMonitoringSystem.Models.PatientVisit>

@{
    ViewData["Title"] = "Patient Monitoring";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Patient Monitoring</h1>

        <a asp-controller="PatientVisit"
           asp-action="Create"
           class="btn btn-primary">
            Register Patient Visit
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-controller="PatientVisit"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">

            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search patient, physician, visit type, status, or visit number..." />

            <button type="submit"
                    class="btn btn-secondary">
                Search
            </button>

        </div>

    </form>


    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>
                            Visit Number
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Physician
                        </th>

                        <th>
                            Visit Type
                        </th>

                        <th>
                            Arrival Time
                        </th>

                        <th>
                            Consultation End Time
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var visit in Model)
                    {
                        <tr>

                            <td>
                                @visit.VisitNumber
                            </td>

                            <td>
                                @visit.FirstName @visit.LastName
                            </td>

                            <td>
                                @visit.Physician
                            </td>

                            <td>
                                @visit.VisitType
                            </td>

                            <td>
                                @visit.ArrivalDateTime.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>
                                @if (visit.ConsultationCompletedDateTime.HasValue)
                                {
                                    @visit.ConsultationCompletedDateTime.Value.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                            </td>

                            <td>

                                @if (visit.Status == "Waiting")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Waiting
                                    </span>
                                }
                                else if (visit.Status == "In Consultation")
                                {
                                    <span class="badge bg-primary">
                                        In Consultation
                                    </span>
                                }
                                else if (visit.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @visit.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-1">

                                    <a asp-controller="PatientVisit"
                                       asp-action="Details"
                                       asp-route-id="@visit.Id"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    @if (visit.Status != "Completed")
                                    {
                                        <a asp-controller="PatientVisit"
                                           asp-action="Edit"
                                           asp-route-id="@visit.Id"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-controller="PatientVisit"
                                           asp-action="Complete"
                                           asp-route-id="@visit.Id"
                                           class="btn btn-success btn-sm">
                                            Complete
                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No patient visits found.
        </div>
    }

</div>